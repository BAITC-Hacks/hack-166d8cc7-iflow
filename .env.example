# Local demo credentials only. Never use these for a public deployment.
DEV_IDENTITIES_JSON='{"demo-employee":{"role":"employee","employee_id":"E0001"},"demo-active":{"role":"employee","employee_id":"E0004"},"demo-hr":{"role":"hr"}}'
NEXT_PUBLIC_API_URL=/backend
# Native Next.js server proxy target (set in frontend/.env.local if overriding).
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:3000
# Optional date override, at least 2026-10-01. Do not move backwards after completions.
APPLICATION_DATE=
# Optional native backend paths; Compose supplies container-specific values.
# DATA_RAW_DIR=/absolute/path/to/data/raw
# STATE_PATH=/absolute/path/to/data/state/state.json
# Native backend reads the root .env; process environment overrides it.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Model is configurable; no automatic provider fallback.
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=10
AI_MAX_OUTPUT_TOKENS=1400
# false = prepare on profile open; true = also prepare everyone in the background.
AI_AUTO_PREPARE=false
# Reserved: NVIDIA is not used until a separate adapter is configured.
NVIDIA_API_KEY=

# Required before connecting the HR SMTP account. Keep this stable across restarts.
# Generate locally: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAIL_ENCRYPTION_KEY=
PUBLIC_APP_URL=http://localhost:3000
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_POLL_SECONDS=2
